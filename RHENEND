def ping_sweep(subnet):
    """Ping sweep entire subnet to find live hosts"""
    print(f"\n{Fore.GREEN}[+] PING SWEEP: {subnet}{Style.RESET_ALL}")
    try:
        network = ipaddress.ip_network(subnet, strict=False)
        live_hosts = []
        
        def ping_host(ip):
            """Ping single host with timeout"""
            try:
                # Cross-platform ping command
                param = "-n" if platform.system().lower() == "windows" else "-c"
                result = subprocess.run(["ping", param, "1", "-W", "1", str(ip)], 
                                      capture_output=True, timeout=3)
                if result.returncode == 0:
                    live_hosts.append(str(ip))
                    print(f"{Fore.GREEN}✓{Style.RESET_ALL} {str(ip)}")
                else:
                    print(f"{Fore.RED}✗{Style.RESET_ALL} {str(ip)}")
            except:
                pass
        
        # Thread pool for fast parallel pinging
        with ThreadPoolExecutor(max_workers=50) as executor:
            futures = [executor.submit(ping_host, ip) for ip in network.hosts()]
            for future in as_completed(futures):
                future.result()
        
        print(f"\n{Fore.GREEN}LIVE HOSTS ({len(live_hosts)}):{Style.RESET_ALL}")
        for host in live_hosts:
            mac = get_mac_address(host)
            print(f"  {Fore.CYAN}{host}{Style.RESET_ALL} (MAC: {mac})")
            
    except ValueError as e:
        print(f"{Fore.RED}[-] Invalid subnet format: {e}{Style.RESET_ALL}")

def scan_port(target, port):
    """Scan single port with socket connection attempt"""
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(0.5)
        result = sock.connect_ex((target, port))
        sock.close()
        return port, result == 0
    except:
        return port, False

def port_scanner():
    """Fast multi-threaded port scanner for top 100 ports"""
    target = input(f"\n{Fore.CYAN}[?] Enter target IP: {Style.RESET_ALL}").strip()
    
    if not target:
        print(f"{Fore.RED}[-] Invalid target{Style.RESET_ALL}")
        return
    
    print(f"\n{Fore.GREEN}[+] FAST PORT SCAN: {target} (Top {len(COMMON_PORTS)} ports){Style.RESET_ALL}")
    print(f"{Fore.YELLOW}Port  Service{Style.RESET_ALL}")
    print("-" * 30)
    
    open_ports = []
    
    # Multi-threaded port scanning with ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=100) as executor:
        futures = {executor.submit(scan_port, target, port): port for port in COMMON_PORTS}
        
        for future in as_completed(futures):
            port, is_open = future.result()
            service = "open" if is_open else "closed"
            color = Fore.GREEN if is_open else Fore.RED
            print(f"{color:>4d}   {service}{Style.RESET_ALL}")
            
            if is_open:
                open_ports.append(port)
    
    print("-" * 30)
    print(f"{Fore.GREEN}OPEN PORTS ({len(open_ports)}): {sorted(open_ports)}{Style.RESET_ALL}")

def internet_health_check():
    """Ping Google DNS for internet connectivity test"""
    target = "8.8.8.8"
    print(f"\n{Fore.GREEN}[+] INTERNET HEALTH CHECK: {target} (Google DNS){Style.RESET_ALL}")
    
    param = "-n" if platform.system().lower() == "windows" else "-c"
    cmd = ["ping", param, "10", "-W", "1", target]
    
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        print(result.stdout)
        
        # Parse results for stats
        lines = result.stdout.splitlines()
        for line in lines:
            if "packet loss" in line.lower() or "Verlorene" in line or "perdidos" in line:
                print(f"{Fore.GREEN}{line.strip()}{Style.RESET_ALL}")
                break
                
    except subprocess.TimeoutExpired:
        print(f"{Fore.RED}[-] Ping timeout - Check your connection{Style.RESET_ALL}")
    except Exception as e:
        print(f"{Fore.RED}[-] Error: {e}{Style.RESET_ALL}")

